# perception-voice (Rust) systemd user service
#
# Installation:
#   1. cargo build --release
#   2. Copy this file to ~/.config/systemd/user/perception-voice.service
#   3. Adjust WorkingDirectory/ExecStart to match your checkout
#   4. systemctl --user daemon-reload && systemctl --user restart perception-voice
#
# View logs:
#   journalctl --user -u perception-voice -f

[Unit]
Description=Perception Voice - Speech to Text Service (Rust)
Documentation=https://github.com/mikesmullin/perception-voice
# sound.target is a no-op under PipeWire -- it does not imply that a capture
# device exists yet. Ordering after the audio stack avoids opening the mic
# before anything can serve it. The capture supervisor retries regardless, so
# this is about avoiding noise at boot, not correctness.
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
After=sound.target

# Startup is now sub-second, which makes systemd's default start limit (5
# starts per 10s) easy to trip just by restarting a few times in a row by
# hand -- and hitting it puts the unit in `failed`, which looks far worse
# than whatever prompted the restarts. Widened enough to allow a burst of
# manual restarts while still catching a genuine crash loop.
StartLimitIntervalSec=30
StartLimitBurst=15

[Service]
Type=simple
WorkingDirectory=/workspace/perception-voice
ExecStart=/workspace/perception-voice/target/release/perception-voice serve
Restart=on-failure
RestartSec=5
# Shutdown is prompt: the accept loop polls its stop flag every 100ms and the
# worker threads are cooperative. This is a safety net, not a routine wait.
TimeoutStopSec=10s

Environment=PULSE_SERVER=unix:/run/user/%U/pulse/native

[Install]
WantedBy=default.target
